 "sequoia": {
  "name": "The giant sequoia slice",
  "run": "1114-185043-sequoia-v1.5",
  "narration_claims": [
   {
    "line": "I was one thousand three hundred years old. One hundred and one metres tall.",
    "facts": [
     {
      "id": "age_height",
      "text": "The tree was 1,300 years old and 101 metres tall when it was felled in California.",
      "source": "https://www.nhm.ac.uk/discover/giant-sequoia-slice.html"
     }
    ]
   },
   {
    "line": "They felled me so museums could show me to you.",
    "facts": [
     {
      "id": "felled_for_museums",
      "text": "The Mark Twain Tree was felled so that sections of the trunk could be shown in museums in New York and London.",
      "source": "https://theplosblog.plos.org/2018/05/mark-twain-and-the-big-stump-can-we-save-nature-from-ourselves/"
     }
    ]
   },
   {
    "line": "I've been at this museum since eighteen ninety-three.",
    "facts": [
     {
