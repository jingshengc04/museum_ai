 "sophie": {
  "name": "Sophie the Stegosaurus",
  "run": "1114-185041-sophie-v1.5",
  "narration_claims": [
   {
    "line": "Look closer. This is bone.",
    "facts": [
     {
      "id": "real_thing",
      "text": "Sir Michael Dixon pointed out that, unlike the museum's Diplodocus cast, Sophie is the real thing.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     }
    ]
   },
   {
    "line": "Spring, two thousand and three. Bob Simon found me buried on a Wyoming hilltop, almost all connected.",
    "facts": [
     {
      "id": "found_when_where",
      "text": "She was found in spring 2003 at Red Canyon Ranch, Wyoming, by Bob Simon, who runs a dinosaur quarry there.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     },
     {
      "id": "found_hilltop",
      "text": "He found her nearly fully connected skeleton buried at the top of a hill while expanding the quarry.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     }
    ]
   },
   {
    "line": "Seventy donors helped buy me.",
    "facts": [
     {
      "id": "seventy_donors",
      "text": "The museum's director thanked 70 generous donors, with particular thanks to Jeremy Herrmann, for making the acquisition possible.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     }
    ]
   },
   {
    "line": "I became the first complete dinosaur on show here in nearly a hundred years.",
    "facts": [
     {
      "id": "first_in_100_years",
      "text": "She was the first complete dinosaur specimen to go on display at the museum in nearly 100 years.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     }
    ]
   },
   {
    "line": "The real thing. One animal, from a Wyoming hilltop to here.",
    "facts": [
     {
      "id": "real_thing",
      "text": "Sir Michael Dixon pointed out that, unlike the museum's Diplodocus cast, Sophie is the real thing.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     },
     {
      "id": "found_hilltop",
      "text": "He found her nearly fully connected skeleton buried at the top of a hill while expanding the quarry.",
      "source": "https://www.nhm.ac.uk/press-office/press-releases/world_s-most-complete-stegosaurus-goes-on-show.html"
     }
    ]
   }
  ],
  "web_facts": [
   {
    "id": "collection_page",
    "text": "The museum's collection page calls her the most complete Stegosaurus ever found and says she was acquired in 2013.",
    "source": "https://www.nhm.ac.uk/our-science/services/collections/palaeontology/dinosaurs.html"
   },
   {
    "id": "morrison_holdings",
    "text": "The museum holds Late Jurassic dinosaur specimens from the Morrison Formation in the USA.",
    "source": "https://www.nhm.ac.uk/our-science/services/collections/palaeontology/dinosaurs.html"
   },
   {
    "id": "first_named_sarah",
    "text": "Her diggers first named her Sarah, after the daughter of the landowners; she was renamed Sophie after the daughter of a donor who helped the museum buy her.",
    "source": "https://cowboystatedaily.com/2026/08/08/digging-wyoming-sophie-the-worlds-most-complete-stegosaurus-was-found-in-shell/"
   },
   {
    "id": "boscarelli",
    "text": "Bob Simon dug her out together with Robert Boscarelli.",
    "source": "https://cowboystatedaily.com/2026/08/08/digging-wyoming-sophie-the-worlds-most-complete-stegosaurus-was-found-in-shell/"
   },
   {
    "id": "shell_morrison",
    "text": "Sophie was found in the Morrison Formation near Shell, Wyoming; the rock dates to the Late Jurassic, around 150 million years ago.",
    "source": "https://cowboystatedaily.com/2026/08/08/digging-wyoming-sophie-the-worlds-most-complete-stegosaurus-was-found-in-shell/"
   },
   {
    "id": "barrett_event",
