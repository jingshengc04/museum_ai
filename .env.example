# Copy to .env (never committed). Everything is mock and free until LIVE names a service.

# Which services make real, paid calls: any of llm,video. Empty = all mock.
LIVE=

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# --- optional ---
# STORY_MODEL=claude-opus-5-5
# VIDEO_MODEL=bytedance/seedance-2.0/fast/reference-to-video   # makes picture and sound together
# VIDEO_RESOLUTION=720p       # about $0.24/s; 480p is about $0.11/s. One film is 2 x 15 s.
# VIDEO_ASPECT=16:9
# FAL_CONCURRENCY=2
# MAX_FAL_USD=8.0             # optional: a film estimated above this refuses to start (no limit when unset)
# OUTLINE_MODEL=u2netp        # u2net is sharper but 176 MB
# REPLAY_SECONDS=12
# SCRIPT_AGENT=harness       # or builtin: storyboard.py writes the script instead of harness/
# IMAGE_MODEL=fal-ai/nano-banana-pro/edit   # reference images for the agent's scripts, about $0.15 each
# HARNESS_TIMEOUT=1500
# Only for the older silent-video path (VIDEO_MODEL=fal-ai/vidu/q2/reference-to-video, LIVE=voice):
# ELEVEN_MODEL=eleven_v3
# ELEVEN_VOICE_ID=
